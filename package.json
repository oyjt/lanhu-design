{
  "name": "lanhu-design",
  "version": "1.4.0",
  "description": "Lanhu design handoff CLI and Agent Skill",
  "type": "module",
  "bin": { "lanhu": "dist/cli.js" },
  "files": ["dist", "skills/lanhu-design", "README.md", "CHANGELOG.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run && node tests/self_check.mjs",
    "test:unit": "vitest run",
    "test:skill": "node tests/self_check.mjs",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "prepack": "pnpm check"
  },
  "engines": { "node": ">=20" },
  "keywords": ["lanhu", "design-to-code", "agent-skill", "cli"],
  "author": "oyjt",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/oyjt/lanhu-design.git" },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@12.4.1",
  "dependencies": {
    "commander": "^14.0.1",
    "default-browser": "^5.5.1",
    "zod": "^4.1.8"
  },
  "optionalDependencies": {
    "@steipete/sweet-cookie": "^0.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "tsx": "^4.20.5",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
